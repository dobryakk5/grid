# Local PostgreSQL (no Docker)
DATABASE_URL=postgresql+asyncpg://grid:CHANGE_ME@127.0.0.1:5432/grid

# Default venue for profiles that do not set one and for venue-agnostic
# endpoints. Per-profile `exchange` (bybit|mexc) overrides this.
EXCHANGE=bybit

# Bybit Demo Trading API credentials.
# IMPORTANT: create these on bybit.com while switched to Demo Trading.
BYBIT_API_KEY=replace_me
BYBIT_API_SECRET=replace_me
BYBIT_BASE_URL=https://api-demo.bybit.com

# MEXC spot API credentials (LIVE trading — MEXC has no demo spot).
# Create on mexc.com with "Spot" trading enabled; whitelist the server IP.
MEXC_API_KEY=replace_me
MEXC_API_SECRET=replace_me
MEXC_BASE_URL=https://api.mexc.com

# Worker settings
GRID_POLL_SECONDS=3

# Reduces SELL quantity after a BUY to leave room for spot fees.
GRID_FEE_BUFFER_PCT=0.002

# ---- Robinhood Chain (on-chain venue, read-only stage) --------------------
# Chain id and router version are pinned: Robinhood Chain only ever deployed
# Universal Router 2.1.1, so asking for 2.0 there is an error.
RH_CHAIN_ID=4663
RH_UNIVERSAL_ROUTER_VERSION=2.1.1
# The only Universal Router on Robinhood Chain. Swap calldata pointing anywhere
# else is refused before signing; blank disables the check.
RH_UNIVERSAL_ROUTER_ADDRESS=0x8876789976decbfcbbbe364623c63652db8c0904
# Robinhood's public RPC is rate-limited; use a provider for anything real.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
# Private key of a DEDICATED bot wallet -- never the main wallet, never a
# seed phrase. Keep this file at chmod 600.
RH_PRIVATE_KEY=
# Address only, for dry runs: quoting and balance checks need an address but no
# key. Ignored once RH_PRIVATE_KEY is set.
RH_WALLET_ADDRESS=

DEX_CHAIN_SLUG=robinhood
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_CACHE_SECONDS=10

# PONS, USDG and WETH ship with their Robinhood Chain addresses, so this stays
# empty for that chain. Overrides are keyed by token symbol, and every address
# must be replaced if DEX_CHAIN_SLUG points at a different chain.
# DEX_TOKENS={"CASHCAT": {"address": "0x...", "decimals": 18}}
DEX_TOKENS=

# Pairs the sampler watches, on top of any profile with exchange=robinhood.
DEX_WATCH_SYMBOLS=PONSUSDG
DEX_SAMPLE_SECONDS=15

# Pool health gates: absolute floors...
DEX_MIN_LIQUIDITY_USD=5000000
DEX_MIN_VOLUME_H24_USD=1000000
# ...and how far the market may decay between arming a level and filling it.
DEX_MAX_LIQUIDITY_DROP_PCT=40
DEX_MAX_VOLUME_DROP_PCT=60

# How close the cheap DexScreener price must get before a Uniswap quote is
# worth spending, and the slippage a swap may tolerate.
DEX_QUOTE_TRIGGER_BAND_PCT=1
DEX_MAX_SLIPPAGE_PCT=0.5
DEX_MIN_ORDER_QUOTE=10

# Canonical Permit2 deployment -- the same address on every chain that has one.
# Checked against the quote's own permitData before anything is signed.
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
# Permit2 expects one unlimited ERC-20 approval to itself, with each swap
# limited by a signed, expiring permit instead. Set true to approve only what
# each trade needs, at one extra approval transaction per trade.
DEX_APPROVE_EXACT=false

# Uniswap Trading API (quotes and swap calldata).
UNISWAP_API_KEY=
UNISWAP_API_BASE=https://trade-api.gateway.uniswap.org/v1
# Uniswap advises refreshing a quote older than about half a minute.
DEX_MAX_QUOTE_AGE_SECONDS=30
DEX_RECEIPT_TIMEOUT_SECONDS=180

# Nothing is signed or broadcast while this is true. Turn it off only for
# a deliberate, supervised run.
DEX_DRY_RUN=true

# DEX worker cadence and recovery thresholds.
DEX_POLL_SECONDS=5
# How long a level waits for its price before it is given up on.
DEX_INTENT_TTL_HOURS=168
# A level blocked by a risk gate re-checks after this long.
DEX_BLOCKED_RETRY_SECONDS=30
# A broadcast with no receipt after this is re-sent unchanged.
DEX_REBROADCAST_AFTER_SECONDS=60
# A transaction still unmined after this is replaced at the same nonce.
DEX_STUCK_AFTER_SECONDS=300
DEX_GAS_BUMP_PCT=25
# How many times a level may be re-armed after an abandoned attempt.
DEX_MAX_RETRIES=3

# ---- FOMO (internal API; own account, research use) ------------------------
# Not a public API -- an internal endpoint the fomo.family web client itself
# calls. The JWT is a short Privy session (~1h) and WILL expire; the /fomo
# page can hold a fresher one in the API process's memory instead of here, so
# leaving this blank is fine day-to-day. To capture one for local testing:
#   Chrome DevTools -> Network -> open fomo.family -> find a request to
#   prod-api.fomo.family -> Request Headers -> Authorization: Bearer eyJ...
#   Save only the part after "Bearer ".
FOMO_JWT=
FOMO_BASE_URL=https://prod-api.fomo.family
FOMO_SUPPORTED_CHAINS=1,56,143,4663,8453,1399811149
FOMO_CACHE_SECONDS=30
FOMO_LEADERBOARD_LIMIT=50
# 429 backoff: start here, double on every further 429, cap at the ceiling.
FOMO_BACKOFF_START_SECONDS=60
FOMO_BACKOFF_MAX_SECONDS=300
FOMO_REGISTRY_POLL_SECONDS=900
# ~24h at 2s/block -- how far back a newly discovered wallet is backfilled,
# so the trade that got it noticed is not the one trade that goes missing.
FOMO_NEW_WALLET_BACKFILL_BLOCKS=43200
# Raw FOMO response inspection endpoint (/api/fomo/raw). Off by default.
FOMO_DEBUG_API=false

# ---- automatic trader discovery -------------------------------------------
# The tape only watches wallets it already knows, so the roster refreshes
# itself: once an interval the worker looks at the watched market, ranks the
# addresses trading it by volume, drops contracts (routers/pools are not
# traders) and adds whoever is new. New wallets go straight into the backfill
# queue, so their recent history is picked up on the same tick.
WALLET_DISCOVERY_ENABLED=true
WALLET_DISCOVERY_INTERVAL_SECONDS=3600
# ~1 minute of chain time at Robinhood Chain's ~15 blocks/second.
WALLET_DISCOVERY_BLOCKS=900
WALLET_DISCOVERY_TOP=20

# ---- Robinhood Chain trade tape (on-chain source of truth) -----------------
RH_CHAIN_NAME=Robinhood Chain
# Quote symbols close enough to $1 that a swap's own quote leg beats any
# external price feed for valuing it in USD.
USD_QUOTE_SYMBOLS=USDG
CHAIN_TAPE_POLL_SECONDS=5
CHAIN_TAPE_BLOCK_BATCH_MAX=2000
CHAIN_TAPE_BLOCK_BATCH_MIN=50
# Blocks the tape stays behind the chain head before treating a block as
# settled -- a cheap reorg guard, not a real one.
CHAIN_TAPE_CONFIRMATIONS=3
# 0 = start the realtime scan from the current chain head.
CHAIN_TAPE_START_BLOCK=0
# Wallets backfilled per pass; they share one scan, so this caps how long a
# backfill may hold up the realtime cursor rather than RPC cost.
CHAIN_TAPE_BACKFILL_WALLETS=50

# ---- Вход оператора --------------------------------------------------
# Сгенерировать: .venv/bin/python scripts/set_password.py
# Пока AUTH_SECRET или AUTH_PASSWORD_HASH пусты, чтение открыто (удобно
# локально), а КАЖДЫЙ эндпоинт, который тратит деньги, отвечает 503.
AUTH_SECRET=
AUTH_PASSWORD_HASH=
AUTH_TOKEN_TTL_MINUTES=720
# Для машинных вызовов (сборщик FOMO передаёт его как GRID_API_TOKEN).
AUTH_SERVICE_TOKEN=

# ---- token intelligence (/intel) -------------------------------------------
# Свод по монетам, которые торгует топ FOMO: рынок (DexScreener там, где он
# индексирует сеть; наша лента для Robinhood Chain), безопасность контракта
# (GoPlus, ключ не нужен) и разбор тезисов. Три оценки — качество, импульс,
# риск — считаются на чтении, ничего не рекомендуют и всегда показывают, из
# каких фактов сложились.
GOPLUS_BASE_URL=https://api.gopluslabs.io
INTEL_REFRESH_SECONDS=600
INTEL_MARKET_TTL_SECONDS=300
INTEL_SECURITY_TTL_HOURS=24
INTEL_MAX_TOKENS=120

# Необязательный разбор тезисов моделью: правила работают всегда, модель
# получает только то, что они не смогли прочитать. Пустой ключ = выключено.
# Установка: pip install -r requirements-intel.txt
INTEL_LLM_PROVIDER=anthropic
INTEL_LLM_API_KEY=
# Для потоковой классификации коротких заметок дешевле claude-haiku-4-5.
INTEL_LLM_MODEL=claude-opus-5
INTEL_LLM_MAX_CALLS=40
INTEL_LLM_TIMEOUT_SECONDS=30
