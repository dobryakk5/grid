[Unit]
Description=Mini Grid Bot Robinhood Chain trade tape
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=gridbot
Group=gridbot
WorkingDirectory=/opt/mini-grid-bot
EnvironmentFile=/opt/mini-grid-bot/.env
ExecStart=/opt/mini-grid-bot/.venv/bin/python -m app.workers.chain_tape
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/mini-grid-bot

[Install]
WantedBy=multi-user.target
